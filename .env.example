# Server Configuration
PORT=3000

# OpenSky Network API (Flight tracking credentials)
OPENSKY_CLIENT_ID=your-opensky-client-id
OPENSKY_CLIENT_SECRET=your-opensky-client-secret

# AISStream API (Maritime vessel tracking)
AISSTREAM_API_KEY=your-aisstream-key
AISSTREAM_LIVE=true
AISSTREAM_BBOX=-15,50,30,95

# Cesium Ion Token (3D digital globe / Starlink visualization)
CESIUM_ION_TOKEN=your-cesium-ion-token

# Google Maps Platform Key (Optional map tile / geocoding layers)
GOOGLE_MAPS_API_KEY=your-google-maps-platform-key

# Telegram Emergency SOS Dispatch (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ATC_CHAT_ID=
TELEGRAM_NAVY_CHAT_ID=
TELEGRAM_STARLINK_CHAT_ID=
TELEGRAM_CHAT_IDS=

# Hardware Serial & Proximity Sensor (Optional)
# ULTRASONIC_SERIAL_PORT=COM3
# ULTRASONIC_BAUD=115200
